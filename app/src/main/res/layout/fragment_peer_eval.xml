<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Gradient header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="0dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_glass_card_small"
                android:src="@drawable/ic_back"
                android:tint="@color/text_primary"
                android:contentDescription="@string/btn_cancel"
                android:scaleType="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/eval_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Period status banner -->
        <LinearLayout
            android:id="@+id/periodStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_eval_period_closed"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <View
                android:id="@+id/periodDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_glass_card_primary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/periodStatusLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/eval_period_closed"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/togglePeriodButton"
                style="@style/Widget.HWiXeL.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/eval_open_period"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tab layout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/evalTabLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            app:tabBackground="@android:color/transparent"
            app:tabIndicatorColor="@color/brand_violet_light"
            app:tabIndicatorHeight="2dp"
            app:tabSelectedTextColor="@color/brand_violet_light"
            app:tabTextColor="@color/text_hint"
            app:tabMode="fixed">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eval_tab_submit" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eval_tab_received" />
        </com.google.android.material.tabs.TabLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/evalLoadingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:indicatorColor="@color/brand_violet"
        app:trackColor="@color/glass_fill" />

    <!-- Main content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- No period card (Team Lead only) -->
            <LinearLayout
                android:id="@+id/noPeriodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eval_no_period_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/eval_no_period_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createPeriodButton"
                    style="@style/Widget.HWiXeL.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/eval_create_period" />
            </LinearLayout>

            <!-- Eval content (shown when period exists) -->
            <LinearLayout
                android:id="@+id/evalContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ── SUBMIT SECTION ── -->
                <LinearLayout
                    android:id="@+id/submitSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Member selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/eval_evaluating_label"
                            style="@style/TextAppearance.HWiXeL.SectionHeader" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            app:boxBackgroundColor="@color/glass_fill"
                            app:boxStrokeColor="@color/glass_border_strong"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            android:hint="@string/eval_select_member_hint">

                            <AutoCompleteTextView
                                android:id="@+id/evaluateeDropdown"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Rating criteria -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/eval_criteria_label"
                            style="@style/TextAppearance.HWiXeL.SectionHeader" />

                        <!-- Communication -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/eval_communication"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/eval_communication_desc"
                                    android:textColor="@color/text_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <RatingBar
                                android:id="@+id/ratingCommunication"
                                style="@style/Widget.AppCompat.RatingBar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:isIndicator="false"
                                android:numStars="5"
                                android:stepSize="1"
                                android:rating="0"
                                android:scaleX="0.58"
                                android:scaleY="0.58"
                                android:progressTint="@color/brand_amber"
                                android:secondaryProgressTint="@color/glass_fill" />
                        </LinearLayout>

                        <!-- Quality -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/eval_quality"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/eval_quality_desc"
                                    android:textColor="@color/text_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <RatingBar
                                android:id="@+id/ratingQuality"
                                style="@style/Widget.AppCompat.RatingBar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:isIndicator="false"
                                android:numStars="5"
                                android:stepSize="1"
                                android:rating="0"
                                android:scaleX="0.58"
                                android:scaleY="0.58"
                                android:progressTint="@color/brand_amber"
                                android:secondaryProgressTint="@color/glass_fill" />
                        </LinearLayout>

                        <!-- Reliability -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/eval_reliability"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/eval_reliability_desc"
                                    android:textColor="@color/text_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <RatingBar
                                android:id="@+id/ratingReliability"
                                style="@style/Widget.AppCompat.RatingBar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:isIndicator="false"
                                android:numStars="5"
                                android:stepSize="1"
                                android:rating="0"
                                android:scaleX="0.58"
                                android:scaleY="0.58"
                                android:progressTint="@color/brand_amber"
                                android:secondaryProgressTint="@color/glass_fill" />
                        </LinearLayout>

                        <!-- Effort -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/eval_effort"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/eval_effort_desc"
                                    android:textColor="@color/text_hint"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <RatingBar
                                android:id="@+id/ratingEffort"
                                style="@style/Widget.AppCompat.RatingBar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:isIndicator="false"
                                android:numStars="5"
                                android:stepSize="1"
                                android:rating="0"
                                android:scaleX="0.58"
                                android:scaleY="0.58"
                                android:progressTint="@color/brand_amber"
                                android:secondaryProgressTint="@color/glass_fill" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Feedback -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/eval_feedback_label"
                            style="@style/TextAppearance.HWiXeL.SectionHeader" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            style="@style/Widget.HWiXeL.TextInputLayout"
                            android:hint="@string/eval_feedback_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/feedbackEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:minLines="3"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Submit button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submitEvalButton"
                        style="@style/Widget.HWiXeL.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/eval_submit_button"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- ── RECEIVED SECTION ── -->
                <LinearLayout
                    android:id="@+id/receivedSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Average received score -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card_primary"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eval_my_avg_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/avgReceivedScoreText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/brand_violet_light"
                            android:textSize="36sp"
                            android:fontFamily="sans-serif-black"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Empty state -->
                    <TextView
                        android:id="@+id/noReceivedEvalsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="@string/eval_no_received"
                        android:textColor="@color/text_hint"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <!-- Received evaluations list -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/receivedEvalsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
