<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/attachmentLabelInputLayout"
        style="@style/Widget.HWiXeL.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/attachment_label_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/attachmentLabelEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/attachmentUrlInputLayout"
        style="@style/Widget.HWiXeL.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/attachment_url_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/attachmentUrlEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/attachment_type_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/attachmentTypeRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@id/radioAttachmentLink"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radioAttachmentPdf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/attachment_type_pdf" />

        <RadioButton
            android:id="@+id/radioAttachmentImage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/attachment_type_image" />

        <RadioButton
            android:id="@+id/radioAttachmentLink"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/attachment_type_link" />
    </RadioGroup>
</LinearLayout>
