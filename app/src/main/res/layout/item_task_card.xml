<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/taskCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/glass_fill"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Priority accent bar (color set via code) -->
        <View
            android:id="@+id/priorityBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/brand_violet" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="0dp">

            <!-- Task title -->
            <TextView
                android:id="@+id/taskTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Redesign login screen with glass cards" />

            <!-- Priority chip row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/priorityChip"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:checkable="false"
                    android:clickable="false"
                    android:textSize="11sp"
                    app:closeIconVisible="false"
                    tools:text="High" />

            </LinearLayout>

            <!-- Deadline text with calendar icon -->
            <TextView
                android:id="@+id/deadlineTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="@color/text_hint"
                tools:text="Due: 25 May 2026" />

            <!-- Subtask ratio text -->
            <TextView
                android:id="@+id/subtaskProgressTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                tools:text="2/5 subtasks" />

            <!-- Subtask progress bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/subtaskProgressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:indicatorColor="@color/brand_violet"
                app:trackColor="@color/glass_border"
                app:trackCornerRadius="2dp"
                app:trackThickness="4dp" />

        </LinearLayout>

        <!-- Change Status button — full width, clearly tappable -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/statusChip"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            app:strokeColor="@color/glass_border_strong"
            app:cornerRadius="8dp"
            android:textColor="@color/text_secondary"
            tools:text="In Progress" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
