<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card_elevated"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Project Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/projectNameInput"
        style="@style/Widget.HWiXeL.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/project_name_label"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Project Goals -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/projectGoalsInput"
        style="@style/Widget.HWiXeL.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/project_goals_label"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:maxLines="4" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Project Description -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/projectDescriptionInput"
        style="@style/Widget.HWiXeL.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/project_description_label"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:maxLines="6" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Deadline Row -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/projectDeadlineButton"
        style="@style/Widget.HWiXeL.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pick_deadline_label"
        app:icon="@drawable/ic_calendar"
        app:iconGravity="start" />

</LinearLayout>
