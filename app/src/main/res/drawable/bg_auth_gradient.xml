<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base — matches activity window bg so no seam at status bar -->
    <item>
        <color android:color="@color/bg_dark" />
    </item>
    <!-- Diagonal violet wash from top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2A1A1B7A"
                android:centerColor="#130F0F5C"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- Bottom-right accent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#00000000"
                android:endColor="#166D5BFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
