<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HWiXeL" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand -->
        <item name="colorPrimary">@color/brand_violet</item>
        <item name="colorPrimaryVariant">@color/brand_violet_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_violet_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_violet_light</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/brand_cyan</item>
        <item name="colorSecondaryVariant">@color/brand_cyan_light</item>
        <item name="colorOnSecondary">@color/bg_dark</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/bg_surface_2</item>

        <!-- Error -->
        <item name="colorError">@color/brand_rose</item>
        <item name="colorOnError">@color/text_on_primary</item>

        <!-- Status bar transparent so gradient shows through -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/bg_dark</item>

        <!-- Shape overrides -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.HWiXeL.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.HWiXeL.LargeComponent</item>

        <!-- Bottom nav -->
        <item name="bottomNavigationStyle">@style/Widget.HWiXeL.BottomNavigationView</item>

        <!-- Text input -->
        <item name="textInputStyle">@style/Widget.HWiXeL.TextInputLayout</item>

        <!-- FAB -->
        <item name="floatingActionButtonStyle">@style/Widget.HWiXeL.FloatingActionButton</item>
    </style>

    <!-- Shape appearances -->
    <style name="ShapeAppearance.HWiXeL.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.HWiXeL.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Glass card style -->
    <style name="Widget.HWiXeL.GlassCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <style name="Widget.HWiXeL.GlassCard.Elevated">
        <item name="cardBackgroundColor">@color/glass_fill_medium</item>
        <item name="strokeColor">@color/glass_border_strong</item>
        <item name="cardElevation">8dp</item>
    </style>

    <style name="Widget.HWiXeL.GlassCard.Primary">
        <item name="cardBackgroundColor">@color/glass_primary</item>
        <item name="strokeColor">@color/glass_primary_border</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Widget.HWiXeL.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Text input layouts -->
    <style name="Widget.HWiXeL.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/glass_fill</item>
        <item name="boxStrokeColor">@color/glass_border_strong</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- FAB -->
    <style name="Widget.HWiXeL.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/brand_violet</item>
        <item name="tint">@color/white</item>
        <item name="elevation">12dp</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.HWiXeL.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.HWiXeL.Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/glass_border_strong</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.HWiXeL.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/brand_violet_light</item>
    </style>

    <!-- Section header -->
    <style name="TextAppearance.HWiXeL.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Chip styles -->
    <style name="Widget.HWiXeL.Chip.Status" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="chipBackgroundColor">@color/glass_fill</item>
        <item name="chipStrokeColor">@color/glass_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Splash/auth background -->
    <style name="Theme.HWiXeL.Splash" parent="Theme.HWiXeL">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
