<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="edu.bluejack252.hwixel.ui.dashboard.DashboardFragment"
        android:label="@string/dashboard_title">
        <action
            android:id="@+id/action_dashboardFragment_to_projectHubFragment"
            app:destination="@id/projectHubFragment">
            <argument
                android:name="projectId"
                app:argType="string" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="edu.bluejack252.hwixel.ui.notifications.NotificationsFragment"
        android:label="@string/nav_notifications" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="edu.bluejack252.hwixel.ui.profile.ProfileFragment"
        android:label="@string/nav_profile" />

    <fragment
        android:id="@+id/projectHubFragment"
        android:name="edu.bluejack252.hwixel.ui.project.hub.ProjectHubFragment"
        android:label="@string/project_hub_title">
        <argument
            android:name="projectId"
            app:argType="string" />
        <action
            android:id="@+id/action_projectHubFragment_to_taskDetailFragment"
            app:destination="@id/taskDetailFragment" />
        <action
            android:id="@+id/action_projectHubFragment_to_createEditTaskFragment"
            app:destination="@id/createEditTaskFragment" />
        <action
            android:id="@+id/action_projectHubFragment_to_attendanceFragment"
            app:destination="@id/attendanceFragment" />
        <action
            android:id="@+id/action_projectHubFragment_to_peerEvalFragment"
            app:destination="@id/peerEvalFragment" />
    </fragment>

    <fragment
        android:id="@+id/attendanceFragment"
        android:name="edu.bluejack252.hwixel.ui.project.attendance.AttendanceFragment"
        android:label="@string/attendance_title">
        <argument
            android:name="projectId"
            app:argType="string" />
        <argument
            android:name="projectName"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/peerEvalFragment"
        android:name="edu.bluejack252.hwixel.ui.project.evaluation.PeerEvalFragment"
        android:label="@string/eval_title">
        <argument
            android:name="projectId"
            app:argType="string" />
        <argument
            android:name="memberIds"
            app:argType="string[]" />
        <argument
            android:name="memberNames"
            app:argType="string[]" />
        <argument
            android:name="memberRoles"
            app:argType="string[]" />
    </fragment>

    <fragment
        android:id="@+id/taskDetailFragment"
        android:name="edu.bluejack252.hwixel.ui.project.taskdetail.TaskDetailFragment"
        android:label="@string/task_detail_title">
        <argument
            android:name="projectId"
            app:argType="string" />
        <argument
            android:name="taskId"
            app:argType="string" />
        <action
            android:id="@+id/action_taskDetailFragment_to_createEditTaskFragment"
            app:destination="@id/createEditTaskFragment" />
    </fragment>

    <fragment
        android:id="@+id/createEditTaskFragment"
        android:name="edu.bluejack252.hwixel.ui.project.taskedit.CreateEditTaskFragment"
        android:label="@string/create_task_title">
        <argument
            android:name="projectId"
            app:argType="string" />
        <argument
            android:name="taskId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

</navigation>
