<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== TOOLBAR AREA ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <!-- Title -->
            <TextView
                android:id="@+id/taskBoardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/task_board_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <!-- Toggle group: Kanban | List -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/viewToggleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kanbanButton"
                    style="@style/Widget.HWiXeL.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/task_view_kanban"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/listButton"
                    style="@style/Widget.HWiXeL.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/task_view_list"
                    android:textSize="12sp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Filter button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterButton"
                style="@style/Widget.HWiXeL.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:contentDescription="@string/task_filter"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:icon="@drawable/ic_filter"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary" />

        </LinearLayout>

        <!-- Thin divider below toolbar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/glass_border" />

        <!-- Loading indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/taskBoardLoadingIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/brand_violet"
            app:trackColor="@color/glass_border" />

        <!-- Content area: kanban / list / empty state -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ===== KANBAN VIEW (HorizontalScrollView) ===== -->
            <HorizontalScrollView
                android:id="@+id/kanbanScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <include
                        android:id="@+id/columnTodo"
                        layout="@layout/layout_kanban_column"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp" />

                    <include
                        android:id="@+id/columnInProgress"
                        layout="@layout/layout_kanban_column"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp" />

                    <include
                        android:id="@+id/columnReview"
                        layout="@layout/layout_kanban_column"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp" />

                    <include
                        android:id="@+id/columnDone"
                        layout="@layout/layout_kanban_column"
                        android:layout_width="200dp"
                        android:layout_height="match_parent" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ===== LIST VIEW (initially GONE) ===== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tasksListRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="12dp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_task_card" />

            <!-- ===== EMPTY STATE ===== -->
            <LinearLayout
                android:id="@+id/emptyTasksContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_board_no_tasks"
                    android:textColor="@color/text_hint"
                    android:textSize="15sp"
                    android:gravity="center" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- ===== FAB ===== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addTaskFab"
        style="@style/Widget.HWiXeL.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/task_add_new"
        app:srcCompat="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
