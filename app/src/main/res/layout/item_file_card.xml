<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Type icon -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_glass_card_primary"
        android:gravity="center">

        <ImageView
            android:id="@+id/fileTypeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/file_type_icon_desc"
            app:tint="@color/brand_violet_light" />
    </LinearLayout>

    <!-- Label + URL + notes -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fileLabelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/fileUrlTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/brand_cyan"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/fileVersionNotesTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_glass_card_small"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Delete button -->
    <ImageButton
        android:id="@+id/fileDeleteButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_glass_card"
        android:contentDescription="@string/file_delete_desc"
        android:padding="8dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/brand_rose" />

</LinearLayout>
